# Copy to .env.local, or run `vercel link` then `vercel env pull .env.local`.
# Never commit real values. None of these may use a NEXT_PUBLIC_ prefix
# except NEXT_PUBLIC_SITE_URL, which is public by design.

# Required. Store API deployment-protection bypass value (prefilled by the
# template's Deploy button). Server-side only.
BYPASS_SECRET=

# Optional. Store API base URL.
API_BASE_URL=https://vercel-agentic-swag-store-api.vercel.app/api

# Local development auth for Vercel AI Gateway and Vercel Sandbox.
# Written by `vercel env pull`; expires after ~12 hours. Not needed on Vercel,
# where OIDC is automatic.
VERCEL_OIDC_TOKEN=

# Optional alternative to OIDC for AI Gateway only (Sandbox still uses OIDC).
# AI_GATEWAY_API_KEY=

# Optional. AI Gateway model for both agents (must support tool calling).
# AI_MODEL=openai/gpt-5-mini

# Optional. Name of the admin agent's persistent sandbox.
# Defaults to ship-it-shop-admin-<VERCEL_ENV>.
# ADMIN_SANDBOX_NAME=

# Optional. Public site URL used for metadata.
# NEXT_PUBLIC_SITE_URL=http://localhost:3000
